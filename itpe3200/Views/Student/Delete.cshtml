@model itpe3200.ViewModels.StudentDeleteViewModel

@{
    ViewData["Title"] = "Delete student";
}
@* Confirmation page before student is deleted *@
<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-6">
        <div class="card border-danger">
            <div class="card-header bg-danger">
                <h1 class="h4 mb-0 text-white">Delete student</h1>
            </div>
            <div class="card-body p-4">
                <p class="lead">Are you sure you want to delete this student?</p>
                <dl class="row g-0 mb-4 detail-list">
                    <dt class="col-5 col-sm-4 eyebrow">Name</dt>
                    <dd class="col-7 col-sm-8">@Model.Name</dd>
                    <dt class="col-5 col-sm-4 eyebrow">Groups</dt>
                    <dd class="col-7 col-sm-8">
                        @if (Model.Groups.Any())
                        {
                            <ul class="list-unstyled mb-0">
                                @foreach (var group in Model.Groups)
                                {
                                    <li>@group.Name (@group.SessionName)</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <span>None</span>
                        }
                    </dd>
                </dl>

                @if (Model.Groups.Any())
                {
                    <div class="alert alert-warning">
                        This student is a member of @Model.Groups.Count @(Model.Groups.Count == 1 ? "group" : "groups").
                        The memberships will be removed, but the groups themselves will not be deleted.
                    </div>
                }

                <form asp-action="DeleteConfirmed" method="post">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
