@model itpe3200.ViewModels.StudentDetailsViewModel

@{
    ViewData["Title"] = "Student details";
}

<h1>@ViewData["Title"]</h1>

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Member of</dt>
    <dd class="col-sm-9">@Model.Groups.Count @(Model.Groups.Count == 1 ? "group" : "groups")</dd>
</dl>

<h2 class="h5">Groups</h2>

@if (!Model.Groups.Any())
{
    <p>This student is not a member of any group yet.</p>
}
else
{
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Group</th>
                <th>Course session</th>
                <th>Joined</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var group in Model.Groups)
            {
                <tr>
                    <td>@group.GroupName</td>
                    <td>@group.SessionName</td>
                    <td>@group.JoinedAt.ToLocalTime().ToString("g")</td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="mt-3">
    <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Update</a>
    <a asp-action="Index" class="btn btn-secondary">Back to list</a>
</div>