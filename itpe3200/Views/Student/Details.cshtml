@model itpe3200.ViewModels.StudentDetailsViewModel

@{
    ViewData["Title"] = "Student details";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-6">
        <a asp-action="Index" class="d-inline-block mb-5">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back to students
        </a>
        <header class="d-flex justify-content-between align-items-start gap-3 mb-4">
            <div>
                <p class="eyebrow mb-1">Details</p>
                <h1 class="h3 mb-2">@Model.Name</h1>
            </div>
            <div class="d-flex gap-1 flex-shrink-0">
                @* Actions on student: edit, delete *@
                <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary"
                   aria-label="Edit @Model.Name" title="Edit student">
                    <i class="bi bi-pencil" aria-hidden="true"></i>
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-danger"
                   aria-label="Delete @Model.Name" title="Delete student">
                    <i class="bi bi-trash3" aria-hidden="true"></i>
                </a>
            </div>
        </header>
        <dl class="row g-0 mb-4 detail-list">
            <dt class="col-sm-4 eyebrow">Member of</dt>
            <dd class="col-sm-8">@Model.Groups.Count @(Model.Groups.Count == 1 ? "group" :
                       "groups")</dd>
            </dl>

            @if (!Model.Groups.Any())
            {
                <p>This student is not currently a member of any group.</p>
            }
            else
            {
                <div class="table-responsive table-card">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Group</th>
                                <th>Course session</th>
                                <th>Joined</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var group in Model.Groups)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Group" asp-action="Details" asp-route-id="@group.Id">
                                            @group.Name
                                        </a>
                                    </td>
                                    <td>@group.SessionName</td>
                                    <td>@group.JoinedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
