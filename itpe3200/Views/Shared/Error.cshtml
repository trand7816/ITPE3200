@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center mt-5">
    <h1 class="display-5 text-danger">Something went wrong</h1>
    <p class="lead">An unexpected error occurred. Please try again, or go back to the front page.</p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted small">Request ID: <code>@Model.RequestId</code></p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Back to home</a>
</div>