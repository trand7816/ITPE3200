@model itpe3200.ViewModels.LoginViewModel

<form asp-controller="Account" asp-action="Login" method="post">
    <!-- Keeps the ReturnUrl so the user ends up where they tried to go -->
    <input type="hidden" asp-for="ReturnUrl" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-floating mb-3">
        <input asp-for="Email" class="form-control" placeholder="name@oslomet.no" autocomplete="name@email.no"/> @*Autocomplete for accessibility purposes*@
        <label asp-for="Email"></label>
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-floating mb-3">
        <input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="password"/>
        <label asp-for="Password"></label>
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100 py-3 fs-5">Log in</button> 
    <p class="text-center mt-1 mb-0">
        <a asp-controller="Account" asp-action="Register" class="btn btn-underline">No account? Sign up now</a>
    </p>

    <div class="mt-1 form-check">
        <input asp-for="RememberMe" class="form-check-input"/>
        <label asp-for="RememberMe" class="form-check-label"></label>
    </div>
</form>