@model itpe3200.ViewModels.SessionCreateViewModel

@{
    ViewData["Title"] = "Create course session";
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <a asp-action="Index" class="d-inline-block mb-3">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back to sessions
        </a>
        <div class="card p-4">
            <p class="eyebrow mb-1">Course sessions</p>
            <h1 class="h3 mb-1">@ViewData["Title"]</h1>
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control"/>
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MaxGroups" class="form-label"></label>
                    <input asp-for="MaxGroups" class="form-control" type="number" min="1" max="20" />
                    <span asp-validation-for="MaxGroups" class="text-danger"></span>
                </div>
    
                <div class="mb-3">
                    <label asp-for="GroupSize" class="form-label"></label>
                    <input asp-for="GroupSize" class="form-control" type="number" min="1" max="50" />
                    <span asp-validation-for="GroupSize" class="text-danger"></span>
                </div>


                <div class="form-check mb-3">
                    <input asp-for="RandomAssignment" class="form-check-input" />
                    <label asp-for="RandomAssignment" class="form-check-label">
                        Randomly assign students to groups
                    </label>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">Create session</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>

            </form>
        </div>
    </div>
</div>
