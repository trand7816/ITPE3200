@model IEnumerable<itpe3200.Models.CourseSession>

@{
    ViewData["Title"] = "Course sessions";
}

<div class="col-xl-11 mx-auto">
    @* Header: same layout as the Groups overview *@
    <header class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <p class="eyebrow mb-1">Overview</p>
            <h1 class="h3 mb-2">@ViewData["Title"]</h1>
            <p class="mb-2">All your course sessions</p>
            <span class="stat-pill">@Model.Count() @(Model.Count() == 1 ? "session" : "sessions")</span>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Create session
        </a>
    </header>

@if (!Model.Any())
{
    <p>No course sessions have been created yet.</p>
}
else
{
    <div class="row g-3">
        @foreach (var session in Model)
            {
                <div class="col-sm-6 col-xl-4"> 
                    <partial name="_SessionOverviewCard" model="session" />
                </div>
            }
    </div>
}
</div>