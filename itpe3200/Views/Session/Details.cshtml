@model itpe3200.ViewModels.SessionDetailsViewModel

@{
    ViewData["Title"] = "Session details";
}

<h1>@ViewData["Title"]</h1>

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Join code</dt>
    <dd class="col-sm-9">@Model.JoinCode</dd>

    <dt class="col-sm-3">Maximum groups</dt>
    <dd class="col-sm-9">@Model.MaxGroups</dd>

    <dt class="col-sm-3">Random assignment</dt>
    <dd class="col-sm-9">@(Model.RandomAssignment ? "Yes" : "No")</dd>

    <dt class="col-sm-3">Created</dt>
    <dd class="col-sm-9">@Model.CreatedAt.ToLocalTime().ToString("g")</dd>
</dl>

<h2>Groups</h2>

@if (!Model.Groups.Any())
{
    <p>No groups have been created for this session yet.</p>
}
else
{
    foreach (var group in Model.Groups)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h3 class="h5">@group.Name</h3>

                <p>
                    Members: @group.MemberCount / @group.MaxSize
                </p>

                @if (!group.Members.Any())
                {
                    <p class="text-muted">No students in this group.</p>
                }
                else
                {
                    <ul>
                        @foreach (var member in group.Members)
                        {
                            <li>@member</li>
                        }
                    </ul>
                }
            </div>
        </div>
    }
}
if (User.IsInRole("Teacher")) {
    <a asp-action="Index" class="btn btn-secondary">Back to sessions</a>

} else {
    <a asp-action="Join" class="btn btn-secondary">Back to join session</a>
}