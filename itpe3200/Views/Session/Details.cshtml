@model itpe3200.ViewModels.SessionDetailsViewModel

@{
    ViewData["Title"] = "Session details";
}
@* Session details: header with join code and actions *@
<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-6">
        <a asp-action="Index" class="d-inline-block mb-5">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back to sessions
        </a>
        <header class="d-flex justify-content-between align-items-start gap-3 mb-4">
            <div>
                <p class="eyebrow mb-1">Details</p>
                <h1 class="h3 mb-1">@Model.Name</h1>
            </div>

            <div class="d-flex gap-1 flex-shrink-0">
                @* Actions on session: edit, delete *@
                <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary"
                   aria-label="Edit @Model.Name" title="Edit session">
                   <i class="bi bi-pencil" aria-hidden="true"></i>
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-danger"
                   aria-label="Delete @Model.Name" title="Delete session">
                   <i class="bi bi-trash3" aria-hidden="true"></i>
                </a>
            </div>
        </header>

        @* Session information as a definition list. g-0 removes the row gutters so the lines align with the text *@
        <dl class="row g-0 mb-4">
            <dt class="col-sm-4 eyebrow py-2 border-bottom mb-0">Join code</dt>
            <dd class="col-sm-8 py-2 border-bottom mb-0">
                <div class="d-flex align-items-center gap-2 mb-0">
                    <p class="mb-0">@Model.JoinCode</p>
                    @* Fullscreen join-code *@
                    <button type="button" class="btn btn-outline-secondary session-fullscreen-btn flex-shrink-0 mt-0"
                            data-bs-toggle="modal" data-bs-target="#codeModal-@Model.Id"
                            aria-label="Show join code in full screen" title="Show join code">
                        <i class="bi bi-fullscreen" aria-hidden="true"></i>
                    </button>
            </dd>
            <dt class="col-sm-4 eyebrow py-2 border-bottom mb-0">Groups</dt>
            <dd class="col-sm-8 py-2 border-bottom mb-0">
                @* Same rule as the session cards: show "x / y" only if the session has a max *@
                @if (Model.MaxGroups > 0)
                {
                    <span>@Model.Groups.Count / @Model.MaxGroups</span>
                }
                else
                {
                    <span>@Model.Groups.Count</span>
                }
            </dd>

            <dt class="col-sm-4 eyebrow py-2 border-bottom mb-0">Random assignment</dt>
            <dd class="col-sm-8 py-2 border-bottom mb-0">@(Model.RandomAssignment ? "Yes" : "No")</dd>

            <dt class="col-sm-4 eyebrow py-2 border-bottom mb-0">Created</dt>
            <dd class="col-sm-8 py-2 border-bottom mb-0">@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</dd>
        </dl>

        @* Group Details: using collapsible row as in Group/Table*@
        @if (!Model.Groups.Any())
        {
            <p>No groups have been created for this session yet.</p>
        }
        else
        {
            <div class="table-responsive table-card">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th style="width: 1%"><span class="visually-hidden">Show members</span></th>
                            <th>Group</th>
                            <th class="text-end">Members</th>
                        </tr>
                    </thead>
                    @* data-bs-parent points to this id so only one group is open at a time*@
                    <tbody id="session-groups">
                        @foreach (var group in Model.Groups)
                        {
                            <tr class="group-row">
                                @* Opens and closes the member row below *@
                                <td>
                                    <button class="btn btn-sm members-toggle" title="Show members" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#session-group-@group.Id"
                                            aria-expanded="false" aria-controls="session-group-@group.Id"
                                            aria-label="Show members of @group.Name">
                                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                    </button>
                                </td>
                                <td><a asp-controller="Group" asp-action="Details" asp-route-id="@group.Id">@group.Name</a></td>
                                <td class="text-end"><span class="stat-pill">@group.MemberCount / @group.MaxSize</span></td>
                                </tr>

                                @* Hidden member row. data-bs-parent="#session-groups" keeps only one open at a time *@
                                <tr class="collapse member-row" id="session-group-@group.Id" data-bs-parent="#session-groups">
                                    <td colspan="3">
                                        <p class="small text-uppercase text-muted mb-2">Members</p>

                                        @if (!group.Members.Any())
                                        {
                                            <p class="mb-0">No members yet.</p>
                                        }
                                        else
                                        {
                                            <ul class="list-unstyled d-flex flex-wrap gap-2 mb-0">
                                                @foreach (var member in group.Members)
                                                {
                                                    <li class="stat-pill">@member</li>
                                                }
                                            </ul>
                                        }
                                    </td>
                            
                                </tr>
                            }
                        
                        </tbody>

                    </table>
                </div>
            }
        </div>
    </div>

    @* Fullscreen modal *@
    <div class="modal fade" id="codeModal-@Model.Id" tabindex="-1" aria-labelledby="codeModalLabel-@Model.Id"
         aria-hidden="true">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content code-modal">
                <div class="modal-header border-0">
                    <h2 class="modal-title fs-5" id="codeModalLabel-@Model.Id">@Model.Name</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                    </button>
                </div>
                <div class="modal-body d-flex flex-column justify-content-center align-items-center text-center">
                    <p class="fs-3">Join @Model.Name with this code:</p>
                    <p class="code-modal-code">@Model.JoinCode</p>
                </div>
            </div>
        </div>
    </div>