@model itpe3200.ViewModels.GroupCreateViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Create group";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <a asp-action="Table" class="d-inline-block mb-3">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back to groups
        </a>
        <div class="card p-4">
            <p class="eyebrow mb-1">Groups</p>
            <h1 class="h3 mb-1">@ViewData["Title"]</h1>
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control">
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MaxSize" class="form-label"></label><span class="text-danger">*</span>
                    <input asp-for="MaxSize" class="form-control" type="number" min="1" aria-describedby="maxsize-help">
                    <div id="maxsize-help" class="form-text">
                        Maximum number of students in the group
                    </div>
                    <span asp-validation-for="MaxSize" class="text-danger"></span>
                </div>
     
                <div class="mb-3">
                    <label asp-for="CourseSessionId" class="form-label">Course Session</label><span class="text-danger">*</span>
                    <select asp-for="CourseSessionId" asp-items="@(new SelectList(Model.CourseSessions, "Id", "Name"))"
                            class="form-select">
                        <option value="">Choose course session</option>
                    </select>
                    <span asp-validation-for="CourseSessionId" class="text-danger"></span>
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">Create group</button>
                    <a asp-action="Table" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>