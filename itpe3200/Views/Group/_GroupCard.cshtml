@model itpe3200.Models.Group

<div class="card h-100">
    <div class="card-body">
        <h2 class="h5 card-title subheading">@Model.Name</h2>

        <p class="card-text">
            Course session: @Model.CourseSession?.Name
        </p>

        <p class="card-text">
            Members: @Model.Members.Count / @Model.MaxSize
        </p>

        <a asp-action="Details"
          asp-route-id="@Model.Id"
          class="btn btn-primary">
           Details
        </a>
    </div>
</div>