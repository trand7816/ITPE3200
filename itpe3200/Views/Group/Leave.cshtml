@model itpe3200.Models.Group

@{
    ViewData["Title"] = "Leave group";
}

@* Confirmation page before a student leaves a group *@
<div class="card border-danger mx-auto mt-4" style="max-width: 600px;">
    <div class="card-header bg-danger text-white">
        <h2 class="h4 mb-0">Delete group</h2>
    </div>
    <div class="card-body">
        <p class="lead">Are you sure you want to leave group @Model.Name?</p>

            <p>You will lose your place in group @Model.Name (@Model.CourseSession?.Name). You can join the session again with the join code.</p>

            <form asp-action="LeaveConfirmed" method="post" class="d-flex gap-2">
                <input type="hidden" name="groupId" value="@Model.Id" />
                <button type="submit" class="btn btn-danger">Leave group</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>