@model itpe3200.Models.Group

@{
    ViewData["Title"] = "Join Session";

    // "join-page" gives the whole page a seperate background color
    ViewData["BodyClass"] = "join-page";
}

@* Step 3 of the join flow: confirmation with the group's members *@
<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card join-card p-4 m-0 text-center">
            <p class="eyebrow">You joined</p>
            <h1 class="display-6 fw-medium">@Model.Name</h1>
            <p class="mb-3">@Model.CourseSession?.Name · @Model.Members.Count / @Model.MaxSize members</p>
            <ul class="list-unstyled d-flex flex-wrap justify-content-center gap-2 join-group-row mb-0">
                @foreach (var member in Model.Members)
                {
                    <li class="stat-pill text-break">@member.Student?.Name</li>
                }
            </ul>
            <a asp-controller="Home" asp-action="Student" asp-fragment="my-groups" class="btn btn-primary mt-3">Go to
                homepage</a>
            </div>
            <partial name="_JoinProgress" model="3" />
        </div>
    </div>