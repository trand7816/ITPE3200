@model itpe3200.ViewModels.GroupDetailsViewModel

@{
    ViewData["Title"] = "Group details";
}

@* Display the page heading. *@
<h1>@ViewData["Title"]</h1>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>

@* Display group information as a definition list. *@
<dl class="row">
    <dt class="col-sm-3">Group name</dt>
    <dd class="col-sm-9">@Model.Group.Name</dd>

    <dt class="col-sm-3">Course session</dt>
    @* ?. prevents an error if the group has no related course session. *@
    <dd class="col-sm-9">@Model.Group.CourseSession?.Name</dd>

    <dt class="col-sm-3">Members</dt>
    @* Show the current number of members compared with the maximum size. *@
    <dd class="col-sm-9">@Model.Group.Members.Count / @Model.Group.MaxSize</dd>
</dl>

<h2>Students</h2>

@* Show a message when the group has no students. *@
@if (!Model.Group.Members.Any())
{
    <p>No students have joined this group yet.</p>
}
else
{
    <ul class="list-unstyled">

        @foreach (var member in Model.Group.Members)
        {
            <li class="d-flex justify-content-between align-items-center mb-2">
                @member.Student?.Name

                @* Teacher can remove student from group - confirmation not added first, because a student can be added back in*@
                @if (User.IsInRole("Teacher"))
                {
                    <form asp-action="RemoveMember" method="post">
                        <input type="hidden" name="groupId" value="@Model.Group.Id" />
                        <input type="hidden" name="studentId" value="@member.StudentId" />
                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                aria-label="Remove @member.Student?.Name from the group" title="Remove from group">
                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                        </button>
                    </form>
                }
            </li>
        }
    </ul>
}
@* Allows student assignment to group if the user has a Teacher role *@
@if (User.IsInRole("Teacher"))
{
    <h2>Assign student to group</h2>
    <form asp-action="AssignStudent" method="post">
        <input type="hidden" name="groupId" value="@Model.Group.Id">

        <div class="form-group mb-3">
            <label for="studentId">Select student</label>

            <select name="studentId" id="studentId" class="form-select" required>
                <option value="">-- Select student --</option>

                @foreach (var student in Model.Students)
                {
                    <option value="@student.Id">@student.Name</option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn-primary">
            Add Student
        </button>
    </form>
}

@* Teachers: Return to the group table. *@
@* Students: Return to homepage. *@

@if (User.IsInRole("Teacher"))
{
    //Which view (Table / Grid) the teacher came from is sent in the url
    //and used to determine what the back to groups button should send back to - added for consistency
    //Anything besides grid falls back to table
    var from = Context.Request.Query["from"].ToString();
    var backTo = from == "Grid" ? "Grid" : "Table";
    <a asp-action="@backTo" class="btn btn-secondary">Back to groups</a>

}
else
{
    <a asp-controller="Home" asp-action="Student" class="btn btn-secondary">Home</a>
    <a asp-action="Leave" asp-route-id="@Model.Group.Id" class="btn btn-outline-danger">Leave group</a>
}