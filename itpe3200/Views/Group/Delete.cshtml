@model Group
@{
    ViewData["Title"] = "Delete group";
}

<div class="card border-danger mx-auto mt-4" style="max-width: 600px;">
    <div class="card-header bg-danger text-white">
        <h2 class="h4 mb-0">Delete group</h2>
    </div>
    <div class="card-body">
        <p class="lead">Are you sure you want to delete this group?</p>

        <dl class="row">
            <dt class="col-sm-4">Name</dt>
            <dd class="col-sm-8">@Model.Name</dd>

            <dt class="col-sm-4">Course session</dt>
            <dd class="col-sm-8">@(Model.CourseSession?.Name ?? "Unknown")</dd>

            <dt class="col-sm-4">Members</dt>
            <dd class="col-sm-8">@Model.Members.Count / @Model.MaxSize</dd>
        </dl>

        @if (Model.Members.Count > 0)
        {
            <div class="alert alert-warning">
                This group has @Model.Members.Count member(s). They will be left without a group, but not deleted.
            </div>
        }

        <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Table" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>