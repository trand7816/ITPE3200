@model Group
@{
    ViewData["Title"] = "Delete group";
}

@* Confirmation page before the group is deleted *@
<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-6">
        <div class="card border-danger">
            <div class="card-header bg-danger">
                <h1 class="h4 mb-0 text-white">Delete group</h1>
            </div>
            <div class="card-body p-4">
                <p class="lead">Are you sure you want to delete this group?</p>
                <dl class="row g-0 mb-4 detail-list">
                    <dt class="col-5 col-sm-4 eyebrow">Name</dt>
                    <dd class="col-7 col-sm-8">@Model.Name</dd>

                    <dt class="col-5 col-sm-4 eyebrow">Course session</dt>
                    <dd class="col-7 col-sm-8">@(Model.CourseSession?.Name ?? "Unknown")</dd>

                    <dt class="col-5 col-sm-4 eyebrow">Members</dt>
                    <dd class="col-7 col-sm-8">@Model.Members.Count / @Model.MaxSize</dd>
                </dl>
                @if (Model.Members.Count > 0)
                {
                    <div class="alert alert-warning">
                        This group has @Model.Members.Count member(s). They will be removed from the group, but the students will not be deleted.
                    </div>
                }

                <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-danger">Delete</button>
                    <a asp-action="Table" class="btn btn-secondary">Cancel</a>
                </form>

            </div>
        </div>
    </div>
</div>