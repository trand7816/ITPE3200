@model itpe3200.ViewModels.GroupsViewModel

@{
    ViewData["Title"] = "Groups";
}
<div class="col-xl-11 mx-auto">
    <partial name="_GroupsHeader" model="Model" />

        @* table-responsive: makes table scroll sideways on small screens instead of making the whole page wider *@
        <div class="table-responsive table-card">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th><span class="visually-hidden">Show members</span></th>
                        @* Columns hidden on small screens (Course session, Max members).
                       Content shown in other columns instead (see _GroupTable.cshtml) *@
                        <th>Group name</th>
                        <th class="d-none d-sm-table-cell">Course session</th>
                        <th>Members</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="group-rows">
                    @foreach (var group in Model.Groups)
                    {
                        <partial name="_GroupTable" model="group" />
                    }
                </tbody>
            </table>
        </div>
</div>