@model itpe3200.ViewModels.GroupsViewModel

@{
    ViewData["Title"] = "Groups";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@ViewData["Title"]</h1>
    <div>
        <a asp-action="Grid" class="btn btn-outline-secondary">Grid view</a>
        <a asp-action="Create" class="btn btn-primary">Create group</a>
    </div>
</div>

@if (!Model.Groups.Any())
{
    <div class="alert alert-info">No groups have been created yet.</div>
}
else
{

<table class="table">
    <thead>
        <tr>
            <th>Group name</th>
            <th>Course session</th>
            <th>Members</th>
            <th>Maximum size</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var group in Model.Groups)
        {
            <partial name="_GroupTable" model="group" />
        }
    </tbody>
</table>
}