@model itpe3200.ViewModels.GroupsViewModel

@{
    ViewData["Title"] = "Groups";
}

<h1>@ViewData["Title"]</h1>

<table class="table">
    <thead>
        <tr>
            <th>Group name</th>
            <th>Course session</th>
            <th>Members</th>
            <th>Maximum size</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
       @foreach (var group in Model.Groups)
{
    <partial name="_GroupTable" model="group" />
}
    </tbody>
</table>