@using Microsoft.EntityFrameworkCore.Infrastructure
@model itpe3200.ViewModels.StudentHomeViewModel


@{
    ViewData["Title"] = "Student Dashboard";
}

<main class="main">
    <section class="row g-3">
        <header class="greeting col-lg-5">
            <div class="greeting-text">
                <span id="date" class="p d-inline-block mb-1">@DateTime.Now.ToString("dddd d MMMM",System.Globalization.CultureInfo.GetCultureInfo("en-US"))</span> <br />
                <h1 class="mb-3"> @Model.Greeting, @Model.StudentName!</h1>
           
                <div id="update d-flex gap-2">
                    <span class="p stat-pill d-inline-block mb-4"> @Model.Groups.Count @(Model.Groups.Count == 1 ?
                                      "group" : "groups")</span>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="#my-groups" class="btn btn-primary"> See your groups</a>
                    </div>
                </div>
            </header>

            <div class="col-lg-7 mt-lg-5">
                <div class="card join-card">
                    <h2 class="h4">Join a session</h2>
                    <p>Got a join code from your teacher?</p>
                    <partial name="_JoinForm" model="new itpe3200.ViewModels.JoinViewModel()" />
                </div>
                <partial name="_JoinProgress" model="1" />
            </div>
        </section>

        <partial name="_MyGroups" model="Model.Groups" />
    </main>