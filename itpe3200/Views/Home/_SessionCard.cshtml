@model itpe3200.Models.CourseSession

@* Partial view for one session card, based on _ItemCard from Demo-ShopMVC-4-DynamicViews. *@
<article class="session-card h-100 position-relative">
    <div class="d-flex justify-content-between align-items-start gap-2">
         <h3 class="h5 mb-0">@Model.Name</h3>

         @* A button for a fullscreen modal for the join codes. *@
         <button type="button" class="btn btn-sm session-fullscreen-btn flex-shrink-0" data-bs-toggle="modal" data-bs-target="#codeModal-@Model.Id"
            aria-label="Show join code in full screen">
                <i class="bi bi-fullscreen" aria-hidden="true"></i>
        </button> 
    </div>
    <p class="session-code mt-3">@Model.JoinCode</p>

    @* Stretched link makes entire card clickable *@
    <a asp-controller="Session" asp-action="Details" asp-route-id="@Model.Id" class="stretched-link session-link"></a>
    @* Number of groups + max if the session has one *@
    @if (Model.MaxGroups > 0)
    {
        <span class="stat-pill">@Model.Groups.Count / @Model.MaxGroups groups</span>
    } else
    {
        <span class="stat-pill">@Model.Groups.Count @(Model.Groups.Count == 1 ? "group" : "groups")</span>
    }
</article>

@* Fullscreen modal *@
<div class="modal fade" id="codeModal-@Model.Id" tabindex="-1" aria-labelledby="codeModalLabel-@Model.Id" aria-hidden="true">
  <div class="modal-dialog modal-fullscreen">
    <div class="modal-content code-modal">
      <div class="modal-header border-0">
        <h2 class="modal-title fs-5" id="codeModalLabel-@Model.Id">@Model.Name</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
        </button>
      </div>
      <div class="modal-body d-flex flex-column justify-content-center align-items-center text-center">
        <p class="fs-3">Join @Model.Name with this code:</p>
        <p class="code-modal-code">@Model.JoinCode</p>
      </div>
    </div>
  </div>
</div> 