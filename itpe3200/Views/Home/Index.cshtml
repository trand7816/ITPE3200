@{
    ViewData["Title"] = "Welcome";
}
@* Welcome page for logged out users: a short introduction, steps for each role and feature cards
   Logged in users are sent to their own homepage (see HomeController.Index) *@
<section>
    <header class="col-lg-6">
        <p class="eyebrow mb-1">Group management made easy</p>
        <h1 class="mb-2">Welcome!</h1>
        <p class="mb-4">Create course sessions and organize students into groups.</p>
    </header>
    
    <div class="row g-3">
        <div class="col-md-6">
            <div class="card join-card p-4">
                <h2 class="h5">For Teachers</h2>
                <ol class="list-unstyled mb-0">
                    <li class="join-group-row mb-2"><strong>1</strong> • Create a course session</li>
                    <li class="join-group-row mb-2"><strong>2</strong> • Share the join code</li>
                    <li class="join-group-row"><strong>3</strong> • Watch the groups fill up!</li>
                </ol>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card join-card p-4">
                <h2 class="h5">For Students</h2>
                <ol class="list-unstyled mb-0">
                    <li class="join-group-row mb-2"><strong>1</strong> • Enter a join code</li>
                    <li class="join-group-row mb-2"><strong>2</strong> • Choose a group</li>
                    <li class="join-group-row"><strong>3</strong> • Get to work!</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mt-3">
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Log in</a>
        <a asp-controller="Account" asp-action="Register" class="btn btn-secondary">Register</a>
    </div>

    @*Feature Cards*@
    <div class="row row-cols-1 row-cols-md-3 g-3 mt-5">
        <div class="col">
            <div class="card h-100 m-0 p-3 py-4">
                <span class="feature-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                         class="bi bi-clock-history" viewBox="0 0 16 16">
                        <path
                        d="M8.515 1.019A7 7 0 0 0 8 1V0a8 8 0 0 1 .589.022zm2.004.45a7 7 0 0 0-.985-.299l.219-.976q.576.129 1.126.342zm1.37.71a7 7 0 0 0-.439-.27l.493-.87a8 8 0 0 1 .979.654l-.615.789a7 7 0 0 0-.418-.302zm1.834 1.79a7 7 0 0 0-.653-.796l.724-.69q.406.429.747.91zm.744 1.352a7 7 0 0 0-.214-.468l.893-.45a8 8 0 0 1 .45 1.088l-.95.313a7 7 0 0 0-.179-.483m.53 2.507a7 7 0 0 0-.1-1.025l.985-.17q.1.58.116 1.17zm-.131 1.538q.05-.254.081-.51l.993.123a8 8 0 0 1-.23 1.155l-.964-.267q.069-.247.12-.501m-.952 2.379q.276-.436.486-.908l.914.405q-.24.54-.555 1.038zm-.964 1.205q.183-.183.35-.378l.758.653a8 8 0 0 1-.401.432z" />
                        <path d="M8 1a7 7 0 1 0 4.95 11.95l.707.707A8.001 8.001 0 1 1 8 0z" />
                        <path
                        d="M7.5 3a.5.5 0 0 1 .5.5v5.21l3.248 1.856a.5.5 0 0 1-.496.868l-3.5-2A.5.5 0 0 1 7 9V3.5a.5.5 0 0 1 .5-.5" />
                    </svg>
                </span>
                <h3 class="h6">Quick group formation</h3>
                <p class="small mb-0">Students join with an autogenereated session code.</p>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 m-0 p-3">
                <span class="feature-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                         class="bi bi-fullscreen" viewBox="0 0 16 16">
                        <path
                        d="M1.5 1a.5.5 0 0 0-.5.5v4a.5.5 0 0 1-1 0v-4A1.5 1.5 0 0 1 1.5 0h4a.5.5 0 0 1 0 1zM10 .5a.5.5 0 0 1 .5-.5h4A1.5 1.5 0 0 1 16 1.5v4a.5.5 0 0 1-1 0v-4a.5.5 0 0 0-.5-.5h-4a.5.5 0 0 1-.5-.5M.5 10a.5.5 0 0 1 .5.5v4a.5.5 0 0 0 .5.5h4a.5.5 0 0 1 0 1h-4A1.5 1.5 0 0 1 0 14.5v-4a.5.5 0 0 1 .5-.5m15 0a.5.5 0 0 1 .5.5v4a1.5 1.5 0 0 1-1.5 1.5h-4a.5.5 0 0 1 0-1h4a.5.5 0 0 0 .5-.5v-4a.5.5 0 0 1 .5-.5" />
                    </svg>
                </span>
                <h3 class="h6">Full-screen join code</h3>
                <p class="small mb-0">Show the join code on the projector with one click.</p>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 m-0 p-3">
                <span class="feature-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                         class="bi bi-people" viewBox="0 0 16 16">
                        <path
                        d="M15 14s1 0 1-1-1-4-5-4-5 3-5 4 1 1 1 1zm-7.978-1L7 12.996c.001-.264.167-1.03.76-1.72C8.312 10.629 9.282 10 11 10c1.717 0 2.687.63 3.24 1.276.593.69.758 1.457.76 1.72l-.008.002-.014.002zM11 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4m3-2a3 3 0 1 1-6 0 3 3 0 0 1 6 0M6.936 9.28a6 6 0 0 0-1.23-.247A7 7 0 0 0 5 9c-4 0-5 3-5 4q0 1 1 1h4.216A2.24 2.24 0 0 1 5 13c0-1.01.377-2.042 1.09-2.904.243-.294.526-.569.846-.816M4.92 10A5.5 5.5 0 0 0 4 13H1c0-.26.164-1.03.76-1.724.545-.636 1.492-1.256 3.16-1.275ZM1.5 5.5a3 3 0 1 1 6 0 3 3 0 0 1-6 0m3-2a2 2 0 1 0 0 4 2 2 0 0 0 0-4" />
                    </svg>
                </span>
                <h3 class="h6">Live group overview</h3>
                <p class="small mb-0">See who has joined and how full each group is.</p>
            </div>
        </div>
    </div>
</section>

