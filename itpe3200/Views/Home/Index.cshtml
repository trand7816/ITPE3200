@{
    ViewData["Title"] = "Welcome";
}
@* Welcome page for logged out users: a short intro and one login form for everyone.
   Logged in users are sent to their own homepage (see HomeController.Index) *@
<section class="row g-3">
    <header class="col-lg-5">
        <div class="greeting-text">
            <h1 class="mb-3">Welcome!</h1>
            <p>Create course sessions and organize students into groups.</p>
            <p class="mb-0">Students join a session with a code from their teacher.</p>
        </div>
    </header>
    <div class="col-lg-7 mt-lg-5">
        <div class="card p-4">
            <h2 class="h4">Log in</h2>
            <partial name="_LoginForm" model="new itpe3200.ViewModels.LoginViewModel()" />
        </div>
    </div>
</section>

