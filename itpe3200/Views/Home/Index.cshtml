@{
    ViewData["Title"] = "Home Page";
}
<style>
/*Move to site.css*/
</style>
  
<main class="main">
    <section class="greeeting"> <!--TODO: Make into partial view-->
        <div class="greeting-text"> 
              <h1> Good Morning! </h1> <!--TODO: Make dynamic (based on user + time) -->
              <span id="date" class="p">@DateTime.Now.ToString("dddd d MMMM", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</span> <br />
              <span id="update" class="p"> 3 courses • 1 live session </span> <!-- Will have live updates-->  
              <a asp-controller="Session" asp-action="Create" class="btn btn-primary">Create Session</a>
              <a asp-controller="Group" asp-action="Create" class="btn btn-primary">Add Group</a>
        </div>
    </section> 

    <!--TODO: Make into partial view-->
    <section id="suggestionsCarousel" class="carousel slide" data-bs-ride="carousel">  <!--Using bootstrap structure-->


        <div class="carousel-inner">
            <!--Suggestion 1--> 
            <div class="carousel-item active" >
                <div class="item-content">
                    <span class="label"> TIP </span>
                    <h2 class="subheading">Share the QR code on screen</h2>
                    <p>Short description</p>
                    <!-- <img src="" alt=""> -->
                    <button class="btn">Try It</button>
                </div>
            </div>
            <!--Suggestion 2--> 
            <div class="carousel-item" >
                <div class="item-content">
                    <span class="label"> TIP </span>
                    <h2 class="subheading">Randomize groups</h2>
                    <p>Short description</p>
                    <!-- <img src="" alt=""> -->
                    <button class="btn">Try It</button>
                </div>
            </div>
         <!--Suggestion 3--> 
            <div class="carousel-item" >
                <div class="item-content">
                    <span class="label"> TIP </span>
                    <h2 class="subheading">Use join codes for easy group formation</h2>
                    <p>Short description</p>
                    <!-- <img src="" alt=""> -->
                    <button class="btn">Try It</button>
                </div>
            </div>
        </div>
         <!-- Carousel buttons-->
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#suggestionsCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Tip 1"></button>
            <button type="button" data-bs-target="#suggestionsCarousel" data-bs-slide-to="1" aria-label="Tip 2"></button>
            <button type="button" data-bs-target="#suggestionsCarousel" data-bs-slide-to="2" aria-label="Tip 3"></button>
        </div>

    <!--Left and Right Controls -->
        <button class="carousel-control-prev" type="button" data-bs-target="#suggestionsCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>

        <button class="carousel-control-next" type="button" data-bs-target="#suggestionsCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </section>    
<section class="course-overview">
    <h1>Your groups</h1>
    <div class="row">
        <div class="col-12 col-md-4">
            <div class="card h-100 d-flex flex-column justify-content-center align-items-center">
                <h2>Example Group</h2>
                <a>See group info</a>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100 d-flex flex-column justify-content-center align-items-center">
                <h2>Example Group</h2>
                <a>See group info</a>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100 d-flex flex-column justify-content-center align-items-center">
                <h2>Example Group</h2>
                <a>See group info</a>
            </div>
        </div>
    </div>
</section>

</main>