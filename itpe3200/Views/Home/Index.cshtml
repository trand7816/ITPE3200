@{
    ViewData["Title"] = "Welcome";
}

<h1> Welcome! </h1>
<p> Create course sessions and organize students into groups!</p>

<div class="row">
    <div class="col-md-6">
        <div class="card p-3 mb-3">
            <h2 class="h4">Student</h2>
            <p>Got a join code from your teacher?</p>
            <partial name="_JoinForm" model="new itpe3200.ViewModels.JoinViewModel()"/>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card p-3 mb-3">
            <h2 class="h4">Teacher</h2>
            <p> Manage course sessions and student groups </p>
            <partial name="_LoginForm" model="new itpe3200.ViewModels.LoginViewModel()" />
        </div>
    </div>
</div>