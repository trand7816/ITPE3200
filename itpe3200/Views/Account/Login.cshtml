@model itpe3200.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Log in";
}
<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-6">
        <div class="card p-4">
            <p class="eyebrow mb-1">Account</p>
            <h1 class="h3 mb-3">@ViewData["Title"]</h1>
            <form asp-action="Login" method="post">
                @* Keeps the ReturnUrl so the user ends up where they tried to go *@
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-floating mb-3">
                    @*Autocomplete for accessibility purposes*@
                    <input asp-for="Email" class="form-control" placeholder="name@oslomet.no" autocomplete="email" />
                    <label asp-for="Email"></label>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Password" class="form-control" autocomplete="current-password"
                           placeholder="password" />
                    <label asp-for="Password"></label>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="mt-1 form-check mb-3">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label"></label>
                </div>
                <button type="submit" class="btn btn-primary w-100 py-3 fs-5">Log in</button>

            </form>
            <p class="mt-3 mb-0 text-center">
                <a asp-action="Register" class="btn">Don't have an account?  Sign up now</a>
            </p>
        </div>
    </div>
</div>