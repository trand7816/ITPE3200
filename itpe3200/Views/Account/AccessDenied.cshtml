@{
    ViewData["Title"] = "Access denied";
}

<!--Shown when logged-in users open a page their role doesn't allow -->
<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="alert alert-warning">
            <h1>Access Denied</h1>
            <p>You don't have access to this page.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Go to homepage</a>
        </div>
    </div>
</div>